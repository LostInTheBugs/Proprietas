# CoproApp - variables d'environnement (copier vers .env)
# Dev : laisser DATABASE_URL sur sqlite:///./copro.db
COPRO_DATABASE_URL=sqlite:///./copro.db
# Clé de signature des JWT. OBLIGATOIRE dès que COPRO_DATABASE_URL n'est pas
# SQLite : le démarrage est refusé si la valeur par défaut 'change-me' est
# utilisée. Génération : python -c "import secrets; print(secrets.token_hex(32))"
COPRO_SECRET_KEY=
COPRO_UPLOAD_DIR=./uploads
# Stockage des documents : local (dossier ci-dessus) ou s3 (voir README, « Stockage des documents »)
COPRO_STOCKAGE=local
# COPRO_S3_BUCKET=
# COPRO_S3_ENDPOINT_URL=
# COPRO_S3_REGION=
# COPRO_S3_ACCESS_KEY_ID=
# COPRO_S3_SECRET_ACCESS_KEY=
# COPRO_S3_PREFIX=documents/
# Taille maximale d'un document uploadé, en Mo (défaut : 25)
COPRO_UPLOAD_MAX_MB=25
# Origines CORS autorisées (JSON). Vide en prod : le frontend est servi par le
# même backend. Exemple : ["https://app.example.fr"]
COPRO_CORS_ORIGINS=[]
COPRO_FRONTEND_DIST=
